# Telegram bot (from @BotFather)
BOT_TOKEN=

# Chat where drafts are sent for moderation (your personal chat_id or an admin group id)
MODERATION_CHAT_ID=

# Channel where approved posts get published (e.g. @my_channel or -100xxxxxxxxxx)
TARGET_CHANNEL_ID=

# Telethon userbot credentials (from https://my.telegram.org -> API development tools)
# Needed to read public Telegram channels the bot itself cannot join as admin.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Phone number used for the one-time interactive login (scripts/telethon_login.py)
TELEGRAM_PHONE=
# Optional: base64 of the .session file produced by scripts/telethon_login.py,
# used to restore the login on a host where you can't run that script directly
# (e.g. Railway). Leave empty if you ran the login script on this same host.
TELETHON_SESSION_B64=

# Anthropic Claude (text rewrite + poll generation)
ANTHROPIC_API_KEY=

# OpenAI (gpt-image-1 image generation)
OPENAI_API_KEY=
